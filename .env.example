# No credentials are required for the synthetic CRM Migration demonstration.
# Keep real values in the deployment's server-side secret store; never prefix these
# variables with NEXT_PUBLIC_.
EVERYACTION_BASE_URL=https://api.securevan.com/v4
EVERYACTION_CONNECTION_MODE=mock
EVERYACTION_WRITES_ENABLED=false
EVERYACTION_APPLICATION_NAME=
EVERYACTION_API_KEY=

# Clerk authentication. In production/preview these are auto-provisioned by the
# Vercel Marketplace Clerk integration. For local dev, copy this file to .env.local
# and paste the keys from the Clerk dashboard (Developers -> API Keys).
# Sign-in/sign-up routes are set via <ClerkProvider> props in src/app/layout.tsx,
# so no NEXT_PUBLIC_CLERK_SIGN_IN_URL is needed.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
